<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions. There is deliberately NO INTERNET permission in v1: the app is offline.
         ACCESS_NETWORK_STATE is pulled in transitively (WorkManager); it is removed on purpose. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Optional source: read steps that Health Connect already holds from a watch or another
         app. The user grants this inside Health Connect; the app never writes health data.
         The background-read grant is requested only when the provider advertises the feature: while
         the step foreground service runs, the app is not in the foreground, so a background read can
         otherwise be refused. It is never a prerequisite for counting. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!-- Health Connect lives in its own provider package; the settings intent lets the user manage
         the grant. Both are visibility declarations, not permissions. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_HEALTH_CONNECT_SETTINGS" />
        </intent>
    </queries>

    <application
        android:name=".SabeelApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sabeel">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Sabeel">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Health Connect opens this alias when it explains the step permission to the user. It
             renders the same app (no separate screen) and must be exported with the platform
             permission, because Health Connect itself sends the intent. -->
        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Hardware step counter, foreground service type health. -->
        <service
            android:name=".service.StepCounterService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <!-- GPS walk tracking, foreground service type location. -->
        <service
            android:name=".service.WalkTrackingService"
            android:exported="false"
            android:foregroundServiceType="location|health" />

        <!-- Re-arms the step service and the reminder/reconcile chain after a reboot and after an
             app update. Both actions are protected system broadcasts delivered to a non-exported
             receiver; exported=false keeps any third-party app from invoking it. The OEM-only
             QUICKBOOT_POWERON action is deliberately absent: it is not an Android-defined broadcast
             and has no foreground-service-start exemption on Android 12+. -->
        <receiver
            android:name=".platform.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>