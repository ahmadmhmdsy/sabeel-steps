    <!-- الترحيب -->
    <string name="onboarding_step_indicator">الخطوة %1$d من %2$d</string>
    <string name="onboarding_welcome_title">أهلًا بك في سبيل</string>
    <string name="onboarding_welcome_body">مكان هادئ يعدّ خطواتك ويحفظ سجلًا بسيطًا لمشيك. بلا منشورات، بلا ضغط.</string>
    <string name="onboarding_privacy_title">خطواتك تبقى على هاتفك</string>
    <string name="onboarding_privacy_body">بلا حساب، بلا إنترنت، بلا إعلانات أو متتبّعات. لا يغادر شيء هاتفك من تلقاء نفسه؛ فقط ملف CSV تصدّره أنت بنفسك يمكن أن يخرج.</string>
    <string name="onboarding_language_title">اللغة</string>
    <string name="onboarding_goal_title">اختر هدفًا يوميًا</string>
    <string name="onboarding_goal_body">الهدف اليومي يمنح حلقة الخطوات ما تملؤه.</string>
    <string name="onboarding_goal_hint">8,000 خطوة نقطة بداية شائعة. غيّرها لاحقًا من الإعدادات.</string>
    <string name="onboarding_units_title">الوحدات وبيانات الجسم</string>
    <string name="onboarding_units_body">يستخدم سبيل الطول والوزن لتقدير المسافة والطاقة وطول الخطوة فقط. كل الحقول اختيارية.</string>
    <string name="onboarding_body_hint">يمكنك تغيير هذا في أي وقت من الإعدادات.</string>
    <string name="onboarding_permissions_title">إذنان للبداية</string>
    <string name="onboarding_permissions_body">يطلب أندرويد كليهما بشكل منفصل. يفتح سبيل بدونهما، لكن عدّ الخطوات يحتاج إلى إذن التعرّف على النشاط. الموقع اختياري ويُطلب فقط عند تتبّع مشية.</string>
    <string name="onboarding_permissions_note">سبيل لا يطلب الوصول إلى الإنترنت، لذا لا يمكن لما يسجّله أن يغادر هاتفك من تلقاء نفسه.</string>
    <string name="onboarding_finish">ابدأ المشي</string>

    <!-- الخصوصية -->
    <string name="privacy_title">الخصوصية</string>
    <string name="privacy_intro">بُني سبيل ليُبقي بياناتك حيث تنتمي: على هذا الهاتف.</string>
    <string name="privacy_offline_title">بلا إنترنت</string>
    <string name="privacy_offline_body">التطبيق لا يطلب إذن الإنترنت إطلاقًا. لا يمكن رفع خطواتك ومشيك ومساراتك، لأنه لا يوجد ما يرفعها.</string>
    <string name="privacy_ads_title">بلا إعلانات</string>
    <string name="privacy_ads_body">لا مكتبة إعلانات ولا معرّف إعلاني ولا تحليلات استخدام ولا مُبلّغ أعطال في سبيل.</string>
    <string name="privacy_account_title">بلا حساب</string>
    <string name="privacy_account_body">لا تسجّل الدخول أبدًا. لا يوجد خادم لتسجّل الدخول إليه.</string>
    <string name="privacy_control_title">أنت المتحكّم</string>
    <string name="privacy_control_body">صدّر مجاميعك اليومية كملف CSV، أو احذف كل شيء من الإعدادات وقتما تشاء. يحدث كلاهما عند ضغطك فقط.</string>
    <string name="privacy_permissions_title">الأذونات وسببها</string>
    <string name="privacy_permission_activity_body">يقرأ عدّاد الخطوات في الهاتف ليحصي سبيل خطواتك. لا يُقرأ غيره.</string>
    <string name="privacy_permission_notification_body">يظهر تذكيرك اليومي وإشعار بلوغ الهدف. يمكن إيقاف كليهما من الإعدادات.</string>
    <string name="privacy_permission_location_body">يُستخدم فقط أثناء تسجيل مشية لرسم المسار، ولا يُستخدم في الخلفية في غير ذلك.</string>
    <string name="privacy_permissions_note">هذه هي الأذونات الوحيدة التي يطلبها سبيل منك.</string>
    <string name="privacy_estimates_title">تقديرات، لا نصيحة طبية</string>
    <string name="privacy_estimates_body">المسافة والطاقة ودقائق النشاط تقديرات تقريبية مبنية على الخطوات والطول والوزن. ليست قياسات طبية ولا تشخيصًا. استشر مختصًا صحيًا في قراراتك الصحية.</string>

    <!-- حول التطبيق -->
    <string name="about_title">حول التطبيق</string>
    <string name="about_version">الإصدار %1$s</string>
    <string name="about_mission">سبيل سجل خطوات ومشيات صغير يعمل دون اتصال. يبقى هادئًا عن قصد: بلا منشورات، بلا ضغط اجتماعي، بلا اشتراك.</string>
    <string name="about_licenses_title">مبني بمصادر مفتوحة</string>
    <string name="about_licenses_body">Kotlin وJetpack Compose وAndroidX برخصة Apache 2.0. تُحفظ إشعارات التراخيص مع مصدر التطبيق.</string>
    <string name="about_estimates">سبيل ليس جهازًا طبيًا ولا يقدّم نصائح صحية.</string>
    <string name="about_privacy_link">اقرأ وعد الخصوصية</string>
    <!-- اقتراح الهدف -->
    <string name="settings_goal_advice_button">اقترح من روتيني</string>
    <string name="settings_goal_advice_waiting">يحتاج سبيل نحو أسبوعين من الأيام المسجّلة ليقترح هدفًا.</string>
    <string name="settings_goal_advice_close">وسيط أيامك المسجّلة هو %1$s خطوة، قريب من هذا الهدف.</string>
    <string name="settings_goal_advice_hint">بناءً على %1$d يومًا مسجّلًا. لا يغيّر الاقتراح هدفك بأكثر من 10%%، وفقط إذا ضغطته.</string>
