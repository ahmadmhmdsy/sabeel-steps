    <string name="diagnostics_fallbacks_none">None</string>
    <string name="diagnostics_source_note">Sabeel uses the best sensor this phone reports. If a hardware sensor stops sending, another source takes over and this screen says so.</string>
    <string name="home_estimated_note">Estimated from the phone’s motion, not a hardware step counter.</string>
    <string name="home_health_connect_note">Synced from Health Connect (a watch or another app). It can lag behind your phone.</string>
    <string name="estimated_steps_value">≈ %1$s</string>
