    <string name="diagnostics_last_update_none">Not counted yet today</string>
    <string name="diagnostics_permission_label">Activity recognition</string>
    <string name="diagnostics_permission_granted">Allowed</string>
    <string name="diagnostics_permission_missing">Not allowed</string>
    <string name="diagnostics_storage_label">Saving</string>
    <string name="diagnostics_storage_ok">Working</string>
    <string name="diagnostics_storage_failed">Write failed at %1$s</string>
    <string name="diagnostics_permission_body">Without this permission Sabeel cannot read the step counter or step detector at all. Allow it, then open Sabeel again.</string>
    <string name="diagnostics_open_settings">Open app settings</string>
    <string name="diagnostics_battery_button">Open battery settings</string>
    <string name="diagnostics_oem_title">On this phone (%1$s)</string>
    <string name="diagnostics_oem_intro">Some phone makers stop apps in the background to save battery. These settings are the ones that usually matter.</string>
    <string name="diagnostics_oem_xiaomi">Open Settings › Apps › Manage apps › Sabeel. Turn on Autostart, then set Battery saver to No restrictions.</string>
    <string name="diagnostics_oem_samsung">Open Settings › Battery and device care › Battery › Background usage limits and make sure Sabeel is not in Sleeping apps. Then open Settings › Apps › Sabeel › Battery and choose Unrestricted.</string>
    <string name="diagnostics_oem_huawei">Open Settings › Battery › App launch, find Sabeel and turn off automatic management. Then allow it to run in the background.</string>
    <string name="diagnostics_oem_oneplus">Open Settings › Battery › Battery optimization › All apps, find Sabeel and choose Don’t optimize. Also allow background activity in App info.</string>
    <string name="diagnostics_oem_oppo">Open Settings › Battery › App battery management (or App optimization), find Sabeel and allow background activity. On some models it is in Settings › Apps › Sabeel › Battery.</string>
    <string name="diagnostics_oem_vivo">Open Settings › Battery › Background power consumption management, find Sabeel and allow background power usage. Also allow auto-start in iManager.</string>
    <string name="diagnostics_oem_generic">Open Settings › Apps › Sabeel › Battery and choose Unrestricted. If your phone has an autostart or startup manager, allow Sabeel there too.</string>
    <string name="diagnostics_body_title">What can pause counting</string>
    <string name="diagnostics_body_sensor">A measured step sensor only counts while the phone is with you and moving; the estimate reads phone motion and is always marked as estimated. Steps never leave the phone, so nothing can recover steps that were not counted. Health Connect steps come from another app or a watch, can lag, and are applied only as a floor — Sabeel never writes to Health Connect.</string>
    <string name="diagnostics_body_service">Sabeel keeps a small foreground service running. Android or the phone maker can still stop it. Sabeel reconnects when you open the app and after your phone restarts, and it never invents a total to fill a gap.</string>
    <string name="diagnostics_body_battery">Battery saver, a forced stop, or a restart can interrupt counting until Sabeel runs again.</string>
    <string name="diagnostics_body_rest">A rest day never changes the counted steps; only the streak pauses.</string>
    <string name="diagnostics_no_sensor_note">This phone reports no step counter, no step detector and no motion sensor, so no setting can turn counting on.</string>
    <string name="diagnostics_footer">Wording and menus differ between phone models. These instructions are a guide, not a promise.</string>
    <string name="diagnostics_error_no_settings">This phone did not open that settings screen. Open your phone’s Settings app instead.</string>
