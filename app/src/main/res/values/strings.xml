    <string name="onboarding_step_indicator">Step %1$d of %2$d</string>
    <string name="onboarding_welcome_title">Welcome to Sabeel</string>
    <string name="onboarding_welcome_body">A calm place to count your steps and keep a simple walking record. No feed, no pressure.</string>
    <string name="onboarding_privacy_title">Your steps stay on your phone</string>
    <string name="onboarding_privacy_body">No account. No internet. No ads, no trackers. Nothing leaves the phone on its own; only a CSV you export yourself can.</string>
    <string name="onboarding_language_title">Language</string>
    <string name="onboarding_goal_title">Choose a daily goal</string>
    <string name="onboarding_goal_body">A daily target gives the step ring something to fill.</string>
    <string name="onboarding_goal_hint">8,000 steps is a common starting point. Change it later in Settings.</string>
    <string name="onboarding_units_title">Units and body data</string>
    <string name="onboarding_units_body">Sabeel uses height and weight only to estimate distance, energy and stride. Every field is optional.</string>
    <string name="onboarding_body_hint">You can change this any time in Settings.</string>
    <string name="onboarding_permissions_title">Two permissions to start</string>
    <string name="onboarding_permissions_body">Android asks for them separately. Sabeel opens without them, but counting steps needs activity recognition. Location is optional and asked only when you track a walk.</string>
    <string name="onboarding_permissions_note">Sabeel does not request internet access, so nothing it records can leave your phone on its own.</string>
    <string name="onboarding_finish">Start walking</string>

    <!-- Privacy -->
    <string name="privacy_title">Privacy</string>
    <string name="privacy_intro">Sabeel is built to keep your data where it belongs: on this phone.</string>
    <string name="privacy_offline_title">No internet</string>
    <string name="privacy_offline_body">The app does not request internet permission at all. Your steps, walks and routes cannot be uploaded, because there is nothing that can upload them.</string>
    <string name="privacy_ads_title">No ads</string>
    <string name="privacy_ads_body">There is no ad library, no advertising ID, no usage analytics and no crash reporter in Sabeel.</string>
    <string name="privacy_account_title">No account</string>
    <string name="privacy_account_body">You never sign in. There is no server to sign in to.</string>
    <string name="privacy_control_title">You are in control</string>
    <string name="privacy_control_body">Export your daily totals as a CSV file, or delete everything from Settings at any time. Both happen only when you tap them.</string>
    <string name="privacy_permissions_title">Permissions and why</string>
    <string name="privacy_permission_activity_body">Reads the phone’s step counter so Sabeel can count steps. Nothing else is read.</string>
    <string name="privacy_permission_notification_body">Shows your daily reminder and a goal notification. Both can be turned off in Settings.</string>
    <string name="privacy_permission_location_body">Used only while you are tracking a walk, to draw the route. It is not used in the background otherwise.</string>
    <string name="privacy_permissions_note">These are the only permissions Sabeel ever asks you for.</string>
    <string name="privacy_estimates_title">Estimates, not medical advice</string>
    <string name="privacy_estimates_body">Distance, energy and active minutes are rough estimates derived from steps, height and weight. They are not medical measurements and not a diagnosis. Talk to a health professional about health decisions.</string>

