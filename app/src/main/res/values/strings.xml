    <!-- Diagnostics -->
    <string name="diagnostics_title">Why is my count low?</string>
    <string name="diagnostics_intro">Sabeel counts with the best motion source this phone offers: a hardware step counter, a hardware step detector, or a labelled estimate from phone motion. If the number looks low, one of these is usually the reason.</string>
    <string name="diagnostics_now_title">Right now</string>
    <string name="diagnostics_status_label">Counting</string>
    <string name="diagnostics_status_counting">Counting on this phone</string>
    <string name="diagnostics_status_stopped">Paused</string>
    <string name="diagnostics_status_no_permission">No permission</string>
    <string name="diagnostics_status_no_sensor">No step source</string>
    <string name="diagnostics_status_estimated">Counting (estimated)</string>
    <string name="diagnostics_status_synced">Counting (synced from Health Connect)</string>
    <string name="diagnostics_source_label">Source</string>
    <string name="diagnostics_source_counter">Hardware step counter</string>
