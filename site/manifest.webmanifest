  "theme_color": "#0F6B5C",
  "icons": [
    {
      "src": "/sabeel-steps/assets/favicon-180.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/sabeel-steps/assets/favicon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
